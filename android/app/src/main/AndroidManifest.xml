<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">

    <!-- WebView โหลดเวทีอวาตาร์จาก localhost — ต้องมี INTERNET แม้ไม่ออกเน็ตจริง -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- อัปเดตตัวเองจาก GitHub Releases ต้องขอสิทธิ์เปิดตัวติดตั้ง -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES"/>

    <!-- กล้องเชิดหุ่น (motion capture ใบหน้า) — ภาพไม่เคยออกจากเครื่อง
         ประมวลผลด้วย MediaPipe ในหน้าเว็บ ส่งออกมาแค่ค่าน้ำหนักใบหน้า

         🔴 ปลั๊กอิน WebView **ไม่ได้ขอสิทธิ์ระดับระบบให้** onPermissionRequest
         ของมันแค่เรียก request.grant() ฝั่งเว็บเท่านั้น ถ้าแอปยังไม่ได้รับสิทธิ์
         CAMERA จริง getUserMedia จะถูกปฏิเสธโดยที่ฝั่งเว็บเห็นแค่ NotAllowedError
         ฝั่ง Flutter จึงต้องขอสิทธิ์เองก่อนสั่งเปิดโหมด ดู avatar_view.dart -->
    <uses-permission android:name="android.permission.CAMERA"/>

    <!-- ไมค์ — พูดกับเธอ และอัดเสียงตอนโคลนเสียง
         ปลั๊กอิน record ประกาศมาให้อยู่แล้ว แต่ประกาศซ้ำที่นี่เพื่อให้คนอ่าน
         manifest ของแอปเห็นครบว่าแอปนี้ขออะไรบ้าง ไม่ต้องไปไล่ดูของปลั๊กอิน -->
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>

    <!-- ═══ ให้เธอเฝ้างานตอนแอปปิด ═══════════════════════════════
         FOREGROUND_SERVICE / RECEIVE_BOOT_COMPLETED / WAKE_LOCK ปลั๊กอิน
         flutter_background_service ประกาศมาให้แล้ว ที่เหลือต้องประกาศเอง -->

    <!-- Android 14 (API 34) บังคับว่าถ้าใช้ foregroundServiceType ต้องขอสิทธิ์
         ที่คู่กันด้วย ไม่งั้น startForeground โยน SecurityException ทันที -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>

    <!-- Android 13 (API 33) การแจ้งเตือนกลายเป็นสิทธิ์ที่ต้องขอ
         ไม่ได้ขอ = บริการรันอยู่จริงแต่ผู้ใช้ไม่เห็นอะไรเลย -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- 🔴 ตัวชี้ขาดความน่าเชื่อถือของงานเบื้องหลัง
         ไม่ได้ยกเว้น = ระบบหรี่ให้ตื่นทุก 9–15 นาทีแทน 5 และ ROM จีนฆ่าทิ้งเลย
         ประกาศใน manifest อย่างเดียวไม่พอ ผู้ใช้ต้องกดยอมรับเองด้วย -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"/>
    <!-- ปฏิทินของเครื่อง — เธอเป็นเลขา ต้องรู้ตารางจริงถึงจะช่วยอะไรได้
         อ่านอย่างเดียว ไม่ขอสิทธิ์เขียน เพราะยังไม่มีอะไรต้องเขียน
         และสิทธิ์ที่ขอไปโดยไม่ได้ใช้คือสิ่งที่ผู้ใช้จำได้ตอนกดปฏิเสธ -->
    <uses-permission android:name="android.permission.READ_CALENDAR"/>

    <!-- ═══ สายโทรเข้า ═══════════════════════════════════════
         เธอเป็นเลขา ต้องรู้ว่าใครโทรมาถึงจะช่วยอะไรได้

         🔴 บน Android 9 (API 28) ขึ้นไป **เบอร์ที่โทรเข้าไม่ได้มากับ
         broadcast อีกแล้ว** ถ้าไม่มี READ_CALL_LOG จะได้ EXTRA_INCOMING_NUMBER
         เป็นค่าว่างโดยไม่มี error ไม่มี log — ดูเหมือนทำงานแต่ไม่มีเบอร์
         ทั้งสองตัวจึงต้องมาคู่กันเสมอ ไม่ใช่ตัวเลือก -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE"/>
    <uses-permission android:name="android.permission.READ_CALL_LOG"/>

    <!-- เบอร์อย่างเดียวช่วยอะไรไม่ได้ ต้องรู้ว่าเป็นใคร -->
    <uses-permission android:name="android.permission.READ_CONTACTS"/>

    <!-- รับสายแทน · ดู CallBridge.kt ว่าทำได้แค่ไหนและติดตรงไหน -->
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS"/>

    <!-- โทรออกจากแป้นของเราเอง — จำเป็นเมื่อเป็นแอปโทรศัพท์หลัก -->
    <uses-permission android:name="android.permission.CALL_PHONE"/>

    <!-- เครื่องที่ไม่มีซิมก็ยังลงแอปได้ แค่ไม่มีสายให้รับ -->
    <uses-feature android:name="android.hardware.telephony" android:required="false"/>

    <!-- ไม่บังคับ: เครื่องไม่มีกล้องหน้าก็ยังลงแอปได้ แค่ใช้โหมดหุ่นเชิดไม่ได้ -->
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <uses-feature android:name="android.hardware.camera.front" android:required="false"/>

    <!-- โมเดล VRM 33MB เรนเดอร์ผ่าน WebGL ถ้าเครื่องไม่มี GL ES 3.0 จะไม่ไหว -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true"/>

    <application
        android:label="GigGok"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/network_security_config">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- ═══ แอปโทรศัพท์หลัก ═══════════════════════════════
             🔴 ตั้งเป็นแอปหลักแล้ว **ทุกสายของเครื่องผ่านแอปนี้**
             สายเข้า สายออก สายซ้อน · จอสายหรือแป้นโทรพังเมื่อไหร่
             เจ้าของโทรออกรับสายไม่ได้ทั้งเครื่อง ไม่ใช่แค่ฟีเจอร์นี้เสีย

             ทั้งสอง Activity เป็นเนทีฟล้วน ไม่ใช่ Flutter เพราะต้องขึ้นได้
             ทันทีโดยไม่รอ engine — สายดังแล้วจอว่างหลายวินาที = รับสายไม่ได้ -->
        <activity
            android:name=".InCallActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:showOnLockScreen="true"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar"/>

        <activity
            android:name=".DialerActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <!-- แป้นโทรที่ไม่มีเบอร์มาด้วย — คนเปิด "แอปโทรศัพท์" -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <category android:name="android.intent.category.DEFAULT"/>
            </intent-filter>
            <!-- แตะเบอร์จากที่อื่น -->
            <intent-filter>
                <action android:name="android.intent.action.DIAL"/>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="tel"/>
            </intent-filter>
        </activity>

        <!-- ระบบผูกกับบริการนี้เพื่อส่งสายมาให้เรา
             BIND_INCALL_SERVICE ต้องเป็น permission ของ <service> ไม่ใช่ uses-permission
             และ IN_CALL_SERVICE_UI = true คือการบอกว่าเรามีจอสายของตัวเอง -->
        <service
            android:name=".MindInCallService"
            android:exported="true"
            android:permission="android.permission.BIND_INCALL_SERVICE">
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_UI"
                android:value="true"/>
            <meta-data
                android:name="android.telecom.IN_CALL_SERVICE_RINGING"
                android:value="true"/>
            <intent-filter>
                <action android:name="android.telecom.InCallService"/>
            </intent-filter>
        </service>

        <!-- ประเภทของ foreground service ต้องประกาศใน manifest
             ประกาศแค่ตอนเรียก startForeground ไม่พอ — Android ปฏิเสธ
             ปลั๊กอินประกาศ <service> มาให้แล้ว เราเติมแค่ประเภทเข้าไป -->
        <service
            android:name="id.flutter.flutter_background_service.BackgroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- 🔴 เปิดหน้าซื้อของบนเว็บ (url_launcher)
             Android 11+ ซ่อนรายชื่อแอปอื่นไว้ ถ้าไม่ประกาศตรงนี้
             launchUrl จะ**คืน false เงียบ ๆ** ไม่มี error ไม่มีเบราว์เซอร์เปิด
             ผู้ใช้เห็นแค่กดปุ่มซื้อแล้วไม่มีอะไรเกิดขึ้น -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
